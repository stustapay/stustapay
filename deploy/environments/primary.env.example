# Copy this file to deploy/environments/primary.env and fill in production values.

VM_HOST=primary.example.internal
SSH_USER=deploy

AZURE_STORAGE_ACCOUNT=stustapayprimary
AZURE_STORAGE_CONTAINER=web
AZURE_STORAGE_SAS_TOKEN=
STORAGE_PROXY_BASE_URL=

DB_HOST=stustapay-primary.postgres.database.azure.com
DB_PORT=5432
DB_NAME=stustapay
DB_USER=stustapay
DB_PASSWORD='replace-me'

CORE_SECRET_KEY='replace-with-a-strong-secret'

ADMIN_DOMAIN=admin.example.com
CUSTOMERPORTAL_DOMAIN=customer.example.com
TERMINAL_DOMAIN=terminal.example.com
ADMIN_BASE_URL=
CUSTOMERPORTAL_BASE_URL=
TERMINAL_BASE_URL=

TLS_CERT_PATH=/etc/letsencrypt/live/example.com/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/example.com/privkey.pem

HEADWIND_BASE_URL=https://headwind.example.com
HEADWIND_LOGIN=admin
HEADWIND_PASSWORD_MD5='replace-me'
