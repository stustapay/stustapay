# Copy this file to deploy/common.env and adjust the shared defaults.

AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_STORAGE_AUTH_MODE=login
PUBLIC_SCHEME=https

APP_ROOT=/opt/stustapay
CONFIG_PATH=/etc/stustapay/config.yaml
SYSTEMD_DIR=/etc/systemd/system
NGINX_SITES_AVAILABLE_DIR=/etc/nginx/sites-available
NGINX_SITES_ENABLED_DIR=/etc/nginx/sites-enabled
REMOTE_SUDO=sudo
REMOTE_TMP_ROOT=/tmp

DEPLOY_USER=stustapay
DEPLOY_GROUP=stustapay
PYTHON_BIN=python3
SSH_PORT=22
SSH_PRIVATE_KEY=

ADMIN_API_PORT=8081
CUSTOMERPORTAL_API_PORT=8082
TERMINAL_API_PORT=8083

ENABLE_PAYMENT_PROCESSOR=true
ENABLE_TICKET_PROCESSOR=true
ENABLE_BON_GENERATOR=false
ENABLE_TSE_CONTROLLER=false

CORE_TEST_MODE=false
HEADWIND_ENABLED=false
