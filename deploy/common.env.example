# Copy this file to deploy/common.env and adjust the shared local settings.

AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_STORAGE_AUTH_MODE=login

SSH_PORT=22
SSH_PRIVATE_KEY=
REMOTE_SUDO=sudo

BACKEND_REPO_DIR=/var/cashless/stustapay
BACKEND_VENV_DIR=/var/cashless/venv
BACKEND_RUN_USER=cashless
BACKEND_CONFIG_PATH=/etc/cashless/server.yaml
BACKEND_SERVICES='stustapay-admin.service stustapay-customerportal.service stustapay-payment.service stustapay-terminal.service'

ADMIN_BLOB_PATH=dist/apps/administration
CUSTOMERPORTAL_BLOB_PATH=dist/apps/customerportal
